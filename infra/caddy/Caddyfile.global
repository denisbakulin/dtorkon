{
	email {$LETSENCRYPT_EMAIL:admin@example.com}
}

(static_site) {
	root * /srv
	encode zstd gzip

	@siteConfig path /site-config.json
	header @siteConfig Cache-Control "no-cache, no-store, must-revalidate"

	try_files {path} /index.html
	file_server
}

{$PUBLIC_DOMAIN:denisbakulin.ru}, {$ADMIN_DOMAIN:admin.denisbakulin.ru} {
	@api path /api*
	handle @api {
		reverse_proxy api:8000
	}

	handle {
		import static_site
	}
}
